# Build esstracker on glibc 2.31 (Ubuntu 20.04) so the frozen agent runs on 20.04 / 22.04 / 24.04.
# Deadsnakes no longer ships Python 3.11 for focal — compile CPython once in this image.
FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ARG PYTHON_VERSION=3.11.9

RUN apt-get update -qq \
 && apt-get install -y -qq \
      build-essential curl ca-certificates zlib1g-dev libncurses5-dev \
      libgdbm-dev libnss3-dev libssl-dev libreadline-dev libffi-dev libsqlite3-dev \
      libbz2-dev liblzma-dev tk-dev \
      python3-gi python3-gi-cairo gir1.2-gtk-3.0 \
      libappindicator3-1 gir1.2-appindicator3-0.1 \
      libayatana-appindicator3-1 gir1.2-ayatanaappindicator3-0.1 \
      libgtk-3-0 libnotify-bin \
      binutils dpkg-dev fakeroot \
 && curl -fsSL "https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz" \
      -o /tmp/Python.tgz \
 && tar -xzf /tmp/Python.tgz -C /tmp \
 && cd "/tmp/Python-${PYTHON_VERSION}" \
 && ./configure --prefix=/opt/python311 --enable-optimizations --with-lto \
 && make -j"$(nproc)" \
 && make install \
 && /opt/python311/bin/python3 -m ensurepip \
 && /opt/python311/bin/pip install -U pip setuptools wheel \
 && rm -rf "/tmp/Python-${PYTHON_VERSION}" /tmp/Python.tgz \
 && apt-get purge -y build-essential \
 && apt-get autoremove -y -qq \
 && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/python311/bin:${PATH}"

WORKDIR /src
ENTRYPOINT ["bash", "-lc"]
